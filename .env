# Configuration FlexLM Container
VENDOR_NAME=your_vendor_name
HOSTNAME=flexlm-server
MAC_ADDRESS=00:14:4f:8d:24:cc

# Ports configuration
LMGRD_PORT=27000
VENDOR_PORT=27001

# File paths (adjust to your system)
LICENSE_FILE_PATH=./license.dat
VENDOR_DAEMON_PATH=./vendors/your_vendor_daemon
CONFIG_DIR=./config

# Logging configuration
MAX_LOG_SIZE_MB=10
LOG_ROTATION_HOURS=1
RESTART_DELAY=5

# Optional: Resource limits (uncomment if needed)
# CPU_LIMIT=1.0
# MEMORY_LIMIT=512M