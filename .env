# FlexLM V2 Environment Variables

# Vendor Configuration
VENDOR_NAME=default_vendor # Name of the vendor (e.g., ansys, autodesk, etc.)

# Network Configuration
LMGRD_PORT=27000         # Port for the main lmgrd daemon
VENDOR_PORT=27001        # Port for the vendor-specific daemon
MAC_ADDRESS=00:11:22:33:44:55 # MAC address for the license server (HOSTID)
HOSTNAME=flexlm-server     # Desired hostname for the license server

# Log Management
MAX_LOG_SIZE_MB=100      # Maximum size in MB for the vendor log file before rotation